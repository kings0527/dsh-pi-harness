{
  "name": "@local/dsh-pi-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pi Harness compatibility layer for DeepSeek Harness: shared Board, tiered knowledge base, handoff takeover, always-on doctrine, and a local (llama.cpp) reasoning-translation endpoint.",
  "exports": {
    ".": "./index.js",
    "./local-translator": "./local-translator/index.js",
